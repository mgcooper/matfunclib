# matfunclib
# need to ignore the .json files that track projects and toolboxes
manager/workon/functionSignatures.json
manager/workoff/functionSignatures.json
manager/activate/functionSignatures.json
manager/deactivate/functionSignatures.json

# MATLAB Project state. Track resources/project, the project definition
# openProject reads, so a fresh clone opens as a Project without running
# the generator first. Ignore every other path under a resources/ folder:
# MATLAB writes derived caches there, and a cached copy of another
# project's state is machine-local, not source.
**/resources/*
!**/resources/project/

# ignore "submodules" (just repos in subfolders)
exactextract*

# Mac stuff
*~
.DS_Store
Desktop.ini

# Thumbnail cache files
._*
Thumbs.db

# External disks
.Spotlight-*
.Trashes

# Backup
*.tmp
*.bk
*.archive
*.keep
*.old

# microsoft
*.xlsx
*.xlsb
*.xls

